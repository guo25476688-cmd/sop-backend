# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会提交）
# 生产环境请直接在平台（Render / Docker 等）注入这些变量。

# ── 服务 ──
PORT=8000
FLASK_DEBUG=0
MAX_CONTENT_LENGTH=4194304

# 演示模式：未配置真实 Dify Key 的应用返回预置示例内容，便于走通完整流程
DEMO_MODE=0

# ── 数据库 ──
SOP_DB_PATH=./sop_platform.db

# ── 密钥加密（可选，强烈建议生产开启）──
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# ── 管理面鉴权（可选，生产必开）──
# 设置后：/admin 页面 + 所有写接口需 HTTP Basic 认证，用户名任意，密码填这里的值
ADMIN_TOKEN=

# ── Dify 连接 ──
# 在此提供则作为权威来源，覆盖后台 UI 里保存的值
DIFY_BASE_URL=
DIFY_VERIFY_SSL=1
DIFY_TIMEOUT=300

# 6 个 Dify 应用的 API Key（可选；留空则在 /admin 后台 UI 里配置）
DIFY_KEY_A1=
DIFY_KEY_A2=
DIFY_KEY_A3=
DIFY_KEY_A4=
DIFY_KEY_R1=
DIFY_KEY_R2=
